<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/sculpture2"
            android:scaleType="centerCrop"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoysala Stone Carving Heritage"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Hoysala style of temple architecture and sculpture originated in Karnataka during the 11th century. Skilled Shilpis created intricate carvings using soapstone, depicting gods, dancers, animals, and mythological stories."
            android:textSize="16sp"
            android:paddingTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="These traditional carving techniques are passed through generations and remain an important part of India's cultural heritage."
            android:textSize="16sp"
            android:paddingTop="12dp"/>

    </LinearLayout>

</ScrollView>